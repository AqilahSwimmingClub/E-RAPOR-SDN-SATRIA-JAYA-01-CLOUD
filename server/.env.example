# Salin berkas ini menjadi server/.env lalu isi nilainya. JANGAN commit server/.env.
# Seluruh nilai di bawah adalah RAHASIA SERVER dan tidak pernah dikirim ke aplikasi sekolah.

# Kunci penandatangan Activation Token (ECDSA P-256, PKCS#8 PEM).
# Buat dengan: node server/scripts/generate-signing-key.mjs
LICENSE_SIGNING_PRIVATE_KEY_FILE=./server/secrets/license-signing-key.pem

# Alternatif bila hosting hanya menerima environment variable (ganti \n menjadi newline literal):
# LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Pepper untuk hash lookup License Key. Acak, minimal 32 karakter, tidak pernah diganti
# setelah ada lisensi diterbitkan (menggantinya membuat seluruh kunci lama tidak ditemukan).
LICENSE_HASH_PEPPER=

# Kunci enkripsi nilai pemulihan License Key. Acak, minimal 32 karakter.
LICENSE_RECOVERY_KEY=

# Akun Pemilik pertama untuk Owner Panel. Dibuat sekali saat server start.
OWNER_USERNAME=
OWNER_PASSWORD=

# Database PostgreSQL Neon. Ambil "Pooled connection string" dari dashboard Neon.
# Contoh bentuknya: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# Lokasi berkas database SQLite untuk pengembangan lokal, dan alamat server lokal.
# Tidak dipakai di Vercel.
LICENSE_DB_FILE=./server/data/licenses.db
HOST=127.0.0.1
PORT=8787
